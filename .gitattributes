# Preserve the exact bytes recorded by PUBLIC_FILES.json on every platform.
# This disables newline conversion without disabling ordinary text diffs.
* -text
* whitespace=blank-at-eol,-blank-at-eof,space-before-tab

# Elsevier CAS template files are vendored verbatim.
manuscript/cas-common.sty -whitespace
manuscript/cas-model2-names.bst -whitespace
manuscript/cas-sc.cls -whitespace
manuscript_JAG_v2/cas-common.sty -whitespace
manuscript_JAG_v2/cas-model2-names.bst -whitespace
manuscript_JAG_v2/cas-sc.cls -whitespace

*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.tif binary
*.tiff binary
